<view class="container" wx:if="{{detail}}">
  <view class="card">
    <view class="card-title"><view class="title mono">{{detail.contract.contractNo}}</view><view class="pill {{pill}}">{{statusLabel}}</view></view>
    <view class="kv"><text>合同金额</text><text class="price">{{amountText}}</text></view>
    <view class="kv"><text>审批状态</text><text>{{auditLabel}}</text></view>
    <view class="kv"><text>签署状态</text><text>{{signLabel}}</text></view>
    <view class="kv"><text>付款条件</text><text>{{detail.contract.paymentTerms}}</text></view>
  </view>
  <view class="card" wx:if="{{detail.order}}">
    <view class="card-title"><view class="title">生产发货</view></view>
    <view class="kv"><text>订单号</text><text>{{detail.order.orderNo}}</text></view>
    <view class="kv"><text>生产进度</text><text>{{detail.order.productionProgress}}</text></view>
    <view class="kv"><text>物流状态</text><text>{{detail.order.deliveryStatus}}</text></view>
  </view>
  <view class="card">
    <view class="card-title"><view class="title">收款计划</view></view>
    <view wx:for="{{payments}}" wx:key="id" class="list-row"><view class="main"><view class="name">{{item.phase}}</view><view class="desc">计划 {{item.planDate}}</view></view><view><view class="name">{{item.amountText}}</view><view class="pill {{item.pill}}">{{item.statusLabel}}</view></view></view>
    <view wx:if="{{!payments.length}}" class="empty">暂无收款计划</view>
  </view>
  <view class="card">
    <view class="card-title"><view class="title">安装验收</view></view>
    <view wx:for="{{installations}}" wx:key="id" class="list-row"><view class="main"><view class="name">{{item.stageLabel}}</view><view class="desc">计划 {{item.planDate}}</view></view><view class="pill {{item.pill}}">{{item.statusLabel}}</view></view>
    <view wx:if="{{!installations.length}}" class="empty">验收完成后自动建档设备台账</view>
  </view>
  <button wx:if="{{canSign}}" class="btn btn-primary btn-block" bindtap="sign">在线签署合同</button>
</view>
