<view class="container">
  <view class="grid-2">
    <view class="stat"><view class="label">售后工单</view><view class="value">{{tickets.length}}</view><view class="note">{{pending}} 个处理中</view></view>
    <view class="stat"><view class="label">维保/年检</view><view class="value">{{maintenance.length}}</view><view class="note">{{due}} 个 30 天内到期</view></view>
  </view>
  <view style="margin:22rpx 0"><button class="btn btn-primary btn-block" bindtap="goRepair">＋ 在线报修</button></view>
  <view class="chips">
    <view class="chip {{tab === 'ticket' ? 'active' : ''}}" data-tab="ticket" bindtap="switchTab">我的工单</view>
    <view class="chip {{tab === 'maintenance' ? 'active' : ''}}" data-tab="maintenance" bindtap="switchTab">维保计划</view>
  </view>
  <block wx:if="{{tab === 'ticket'}}">
    <view wx:if="{{tickets.length}}" class="card" style="padding:0 28rpx">
      <view wx:for="{{tickets}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="openDetail">
        <view class="main"><view class="name mono">{{item.ticketNo}}</view><view class="desc">{{item.typeLabel}} · {{item.equipmentNo || '未关联设备'}}</view><view class="desc">{{item.description}}</view></view>
        <view class="pill {{item.pill}}">{{item.statusLabel}}</view>
      </view>
    </view>
    <view wx:else class="empty"><view class="big">✚</view>暂无工单</view>
  </block>
  <block wx:else>
    <view wx:if="{{maintenance.length}}" class="card" style="padding:0 28rpx">
      <view wx:for="{{maintenance}}" wx:key="id" class="list-row">
        <view class="main"><view class="name">{{item.equipmentNo}} · {{item.projectLabel}}</view><view class="desc">到期 {{item.nextDate}} · 周期 {{item.cycleMonths}} 个月</view></view>
        <view class="pill {{item.level}}">{{item.remainText}}</view>
      </view>
    </view>
    <view wx:else class="empty">暂无维保计划</view>
  </block>
  <view class="notice blue" style="margin-top:20rpx">年检/定检按 TSG 11 要求执行；到期前平台自动提醒。</view>
</view>
