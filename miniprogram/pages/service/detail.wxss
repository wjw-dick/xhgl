.kv { display: flex; justify-content: space-between; padding: 13rpx 0; border-bottom: 1rpx dashed #e4e7ec; font-size: 23rpx; }
.kv text:first-child { color: #667085; }
.kv text:last-child { max-width: 64%; text-align: right; }
.stars { display: flex; gap: 11rpx; font-size: 44rpx; color: #d8d2c8; margin-bottom: 12rpx; }
.stars .active { color: #d9633b; }
textarea { width: 100%; box-sizing: border-box; background: #fafbfc; border: 1rpx solid #e4e7ec; border-radius: 14rpx; padding: 18rpx; font-size: 24rpx; }
