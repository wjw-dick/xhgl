<view class="container" wx:if="{{detail}}">
  <view class="card">
    <view class="card-title"><view class="title mono">{{detail.quote.quoteNo}}</view><view class="pill {{pill}}">{{statusLabel}}</view></view>
    <view class="kv"><text>产品型号</text><text>{{detail.quote.productName}}</text></view>
    <view class="kv"><text>数量</text><text>{{detail.quote.quantity}}</text></view>
    <view class="kv"><text>单价</text><text>{{unitPriceText}}</text></view>
    <view class="kv"><text>运费</text><text>{{freightText}}</text></view>
    <view class="kv"><text>安装调试费</text><text>{{installText}}</text></view>
    <view class="kv"><text>含税总价</text><text class="price">{{amountText}}</text></view>
    <view class="kv"><text>付款条件</text><text>{{detail.quote.paymentTerms}}</text></view>
    <view class="kv"><text>质保期</text><text>{{detail.quote.warranty}}</text></view>
    <view class="kv"><text>有效期至</text><text>{{validDate}}</text></view>
  </view>
  <view class="card" wx:if="{{negotiations.length}}">
    <view class="card-title"><view class="title">议价记录</view></view>
    <view wx:for="{{negotiations}}" wx:key="id" class="list-row"><view class="main"><view class="name">第{{item.roundNo}}轮 · {{item.partyLabel}}</view><view class="desc">{{item.remark}}</view></view><view class="name">{{item.amountText}}</view></view>
  </view>
  <view wx:if="{{canConfirm}}" class="form-buttons">
    <button class="btn btn-ghost" bindtap="bargain">还价 / 留言</button>
    <button class="btn btn-primary" bindtap="confirm">确认报价</button>
  </view>
  <view wx:elif="{{detail.quote.status === 'CONFIRMED'}}" class="notice blue">报价已确认，合同草稿已生成。</view>
  <view wx:elif="{{detail.quote.status === 'EXPIRED'}}" class="notice">报价已过期，请联系顾问重新报价。</view>
  <view class="footer-tip">确认后系统自动生成合同草稿</view>
</view>
