<view>
  <view class="hero" style="padding-top:80rpx">
    <view style="display:flex;align-items:center;gap:20rpx">
      <view class="avatar">{{(user.name || 'U').slice(0,1)}}</view>
      <view>
        <view class="hero-title" style="font-size:38rpx;margin:0 0 4rpx">{{user.name || customer.name}}</view>
        <view class="hero-sub">用户 · {{customer.name || companyName}}</view>
      </view>
    </view>
  </view>
  <view class="container" style="margin-top:-20rpx;position:relative;z-index:2">
    <view class="card">
      <view class="card-title"><view class="title">企业档案</view></view>
      <view class="menu"><text>客户编号</text><text class="muted">{{customer.customerNo || '—'}}</text></view>
      <view class="menu"><text>所属行业</text><text class="muted">{{customer.industry || '—'}}</text></view>
      <view class="menu"><text>地区</text><text class="muted">{{customer.region || '—'}}</text></view>
      <view class="menu" bindtap="goConsult"><text>在线咨询</text><text>›</text></view>
    </view>
    <view class="card">
      <view class="card-title"><view class="title">我的业务</view></view>
      <view class="menu" bindtap="goDemands"><text>我的需求</text><text>›</text></view>
      <view class="menu" bindtap="goSolutions"><text>我的方案</text><text>›</text></view>
      <view class="menu" bindtap="goQuotes"><text>我的报价</text><text>›</text></view>
      <view class="menu" bindtap="goContracts"><text>我的合同</text><text>›</text></view>
      <view class="menu" bindtap="goService"><text>售后服务与维保</text><text>›</text></view>
    </view>
    <view class="card">
      <view class="card-title"><view class="title">设置与帮助</view></view>
      <view class="menu" bindtap="goAgreement"><text>用户协议与隐私政策</text><text>›</text></view>
      <view class="menu"><text>语言</text><text class="muted">简体中文</text></view>
      <view class="menu"><text>客服热线</text><text class="muted">400-800-6688</text></view>
      <view class="menu"><text>版本</text><text class="muted">v1.0.0</text></view>
    </view>
    <button class="btn btn-ghost btn-block" style="margin-top:20rpx" bindtap="logout">退出登录</button>
    <view class="footer-tip">鑫火锅炉 · 数据仅本人/本企业可见</view>
  </view>
</view>
