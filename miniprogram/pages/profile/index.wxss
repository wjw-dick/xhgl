.avatar { width: 96rpx; height: 96rpx; border-radius: 24rpx; background: rgba(255,255,255,.14); border: 1rpx solid rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center; font-size: 38rpx; }
.menu { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f2f4f7; font-size: 25rpx; }
.menu:last-child { border-bottom: none; }
.menu .muted { color: #98a2b3; font-size: 22rpx; }
