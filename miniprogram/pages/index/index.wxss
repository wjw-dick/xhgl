.hero-top { display: flex; justify-content: space-between; align-items: flex-start; }
.avatar { width: 68rpx; height: 68rpx; border-radius: 50%; background: rgba(255,255,255,.14); border: 1rpx solid rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; margin: 24rpx 0; }
.quick { background: #fff; border: 1rpx solid #e4e7ec; border-radius: 18rpx; text-align: center; padding: 22rpx 6rpx; }
.quick-icon { width: 54rpx; height: 54rpx; border-radius: 14rpx; background: #fdf1ec; color: #d9633b; margin: 0 auto 8rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700; }
.quick-text { font-size: 21rpx; color: #475467; }
.hero-actions { display: flex; gap: 14rpx; margin-top: 26rpx; }
